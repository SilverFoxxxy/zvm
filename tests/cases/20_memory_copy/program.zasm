ALLOC 6 -> R0

MOV 0 -> R1
MARK READ
GE R1, 3 -> R2
JUMPIF R2, COPY_START
READ -> R3
STORE R3 -> [R0 + R1]
ADD R1, 1 -> R1
JUMP READ

MARK COPY_START
MOV 0 -> R1
MARK COPY
GE R1, 3 -> R2
JUMPIF R2, PRINT_START
LOAD [R0 + R1] -> R3
ADD R1, 3 -> R4
STORE R3 -> [R0 + R4]
ADD R1, 1 -> R1
JUMP COPY

MARK PRINT_START
MOV 3 -> R1
MARK PRINT
GE R1, 6 -> R2
JUMPIF R2, END
LOAD [R0 + R1] -> R3
WRITE R3
ADD R1, 1 -> R1
JUMP PRINT

MARK END
WRITE NL
