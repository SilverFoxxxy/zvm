ALLOC 100000 -> R0
MOV 0 -> R1

MARK FILL
GE R1, 100000 -> R2
JUMPIF R2, SUM_START
STORE R1 -> [R0 + R1]
ADD R1, 1 -> R1
JUMP FILL

MARK SUM_START
MOV 0 -> R1
MOV 0 -> R3

MARK SUM
GE R1, 100000 -> R2
JUMPIF R2, DONE
LOAD [R0 + R1] -> R4
ADD R3, R4 -> R3
ADD R1, 1 -> R1
JUMP SUM

MARK DONE
WRITE R3
WRITE NL
