ALLOC 3 -> R0
ALLOC 3 -> R1

MOV 10 -> R2
STORE R2 -> [R0]
MOV 20 -> R2
STORE R2 -> [R0 + 1]
MOV 30 -> R2
STORE R2 -> [R0 + 2]

MOV 100 -> R2
STORE R2 -> [R1]
MOV 200 -> R2
STORE R2 -> [R1 + 1]
MOV 300 -> R2
STORE R2 -> [R1 + 2]

LOAD [R0]     -> R3
LOAD [R0 + 1] -> R4
LOAD [R0 + 2] -> R5
WRITE R3
WRITE R4
WRITE R5
WRITE NL

LOAD [R1]     -> R3
LOAD [R1 + 1] -> R4
LOAD [R1 + 2] -> R5
WRITE R3
WRITE R4
WRITE R5
WRITE NL
